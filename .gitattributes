# 统一换行符为 LF，避免 Windows / macOS 协作时整文件 diff
* text=auto eol=lf

# 明确声明二进制文件，别让 diff 崩掉
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# 这些文件不参与 GitHub 的语言统计
package-lock.json linguist-generated=true
docs/*.png linguist-documentation=true
